{
  "name": "dashboard",
  "description": "Dashboard to Display GitHub Statistics",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.22.1",
    "npm": "12.2.1"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.mjs",
    "postbuild:local": "NEXT_PUBLIC_SITE_URL=http://localhost:8000 next-sitemap --config next-sitemap.config.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:coverage": "jest --coverage --silent"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "marked": "18.1.1",
    "next": "16.4.3",
    "next-sitemap": "4.2.3",
    "octokit": "5.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "resize-observer-polyfill": "1.5.1"
  },
  "overrides": {
    "form-data": "4.0.6"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "importOrder": [
      "@/(.*)$",
      "[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
  }
}
